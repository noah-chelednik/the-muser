{
  "id": "mix/growl-bass",
  "name": "Growl Bass",
  "category": "mix",
  "subcategory": "bass",
  "tags": [
    "edm",
    "aggressive",
    "dubstep"
  ],
  "description": "Driven midrange for EDM and dubstep.",
  "version": 1,
  "factory": true,
  "role": "bass",
  "chain": [
    {
      "type": "highpass",
      "params": {
        "cutoff_hz": 30
      }
    },
    {
      "type": "saturation",
      "params": {
        "drive_db": 14,
        "mix": 0.7
      }
    },
    {
      "type": "peak",
      "params": {
        "freq_hz": 1200,
        "gain_db": 3,
        "q": 1
      }
    },
    {
      "type": "compressor",
      "params": {
        "threshold_db": -16,
        "ratio": 6,
        "attack_ms": 5,
        "release_ms": 80,
        "makeup_db": 3
      }
    },
    {
      "type": "width",
      "params": {
        "width": 1.1
      }
    }
  ]
}
