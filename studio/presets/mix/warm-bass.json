{
  "id": "mix/warm-bass",
  "name": "Warm Bass",
  "category": "mix",
  "subcategory": "bass",
  "tags": [
    "warm",
    "lofi",
    "chill"
  ],
  "description": "Rounded, soft low end for chill styles.",
  "version": 1,
  "factory": true,
  "role": "bass",
  "chain": [
    {
      "type": "highpass",
      "params": {
        "cutoff_hz": 35
      }
    },
    {
      "type": "lowpass",
      "params": {
        "cutoff_hz": 3500
      }
    },
    {
