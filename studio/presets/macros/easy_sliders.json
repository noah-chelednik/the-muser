{
  "version": 1,
  "sliders": [
    {
      "key": "energy",
      "label": "Energy",
      "help": "Calm to hype. Drives drums, compression and grit.",
      "maps": [
        {
          "scope": "role:drums",
          "only": "stems",
          "op": "gain",
          "value": [
            -5,
            4
          ]
        },
        {
          "scope": "role:bass",
          "only": "stems",
          "op": "gain",
          "value": [
            -2,
            2
          ]
        },
        {
          "scope": "master",
          "when": "above",
          "op": "insert",
          "fx": {
            "type": "compressor",
            "params": {
              "threshold_db": [
                -8,
                -22
              ],
              "ratio": [
                1.5,
                4
              ],
              "attack_ms": 25,
              "release_ms": 150,
              "makeup_db": [
                0,
                2
              ]
            }
          }
        },
        {
          "scope": "master",
          "when": "above",
          "op": "insert",
          "fx": {
            "type": "saturation",
            "params": {
              "drive_db": [
                0,
                7
              ],
              "mix": 0.5
            }
          }
        },
        {
          "scope": "master",
          "only": "mix",
          "when": "below",
          "op": "insert",
          "fx": {
            "type": "peak",
            "params": {
              "freq_hz": 3500,
              "gain_db": [
                -3,
                0
              ],
              "q": 0.7
            }
          }
        }
      ]
    },
    {
      "key": "vocals",
      "label": "Vocals",
      "help": "Pull the voice back or push it to the front.",
      "maps": [
        {
          "scope": "roles:vocals,lead",
          "only": "stems",
          "op": "gain",
          "value": [
            -9,
            6
          ]
        },
        {
          "scope": "roles:vocals,lead",
          "only": "stems",
          "op": "insert",
          "fx": {
            "type": "peak",
            "params": {
              "freq_hz": 3000,
              "gain_db": [
                -2,
                3
              ],
              "q": 0.9
            }
          }
        },
        {
          "scope": "master",
          "only": "mix",
          "op": "insert",
          "fx": {
            "type": "peak",
            "params": {
              "freq_hz": 2500,
              "gain_db": [
                -4,
                3
              ],
              "q": 0.8
            }
          }
        }
      ]
    },
    {
      "key": "bass",
      "label": "Bass",
      "help": "Thin to heavy low end.",
      "maps": [
        {
          "scope": "role:bass",
          "only": "stems",
          "op": "gain",
          "value": [
            -9,
            6
          ]
        },
        {
          "scope": "master",
          "op": "insert",
          "fx": {
            "type": "lowshelf",
            "params": {
              "cutoff_hz": 90,
              "gain_db": [
                -5,
                5
              ],
              "q": 0.7
            }
          }
        }
      ]
    },
    {
      "key": "brightness",
      "label": "Brightness",
      "help": "Dark and warm to crisp and airy.",
      "maps": [
        {
          "scope": "master",
          "op": "insert",
          "fx": {
            "type": "highshelf",
            "params": {
              "cutoff_hz": 7500,
              "gain_db": [
                -6,
                6
              ],
              "q": 0.7
            }
          }
        },
        {
          "scope": "master",
          "when": "below",
          "op": "insert",
          "fx": {
            "type": "lowpass",
            "params": {
              "cutoff_hz": [
                7000,
                20000
              ]
            }
          }
        }
      ]
    },
    {
      "key": "space",
      "label": "Space",
      "help": "Dry and close to big and wide.",
      "maps": [
        {
          "scope": "roles:drums,keys,lead,vocals,guitar,other",
          "only": "stems",
          "op": "insert",
          "fx": {
            "type": "reverb",
            "params": {
              "room_size": [
                0.3,
                0.85
              ],
              "damping": 0.5,
              "width": 1.0,
              "mix": [
                0.0,
                0.3
              ]
            }
          }
        },
        {
          "scope": "master",
          "only": "mix",
          "op": "insert",
          "fx": {
            "type": "reverb",
            "params": {
              "room_size": [
                0.3,
                0.8
              ],
              "damping": 0.55,
              "width": 1.0,
              "mix": [
                0.0,
                0.16
              ]
            }
          }
        },
        {
          "scope": "master",
          "op": "insert",
          "fx": {
            "type": "width",
            "params": {
              "width": [
                0.75,
                1.45
              ]
            }
          }
        }
      ]
    }
  ]
}
