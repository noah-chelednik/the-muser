    {
      "type": "saturation",
      "params": {
        "drive_db": 6,
        "mix": 0.5
      }
    },
    {
      "type": "delay",
      "params": {
        "time_ms": 250,
        "feedback": 0.35,
        "mix": 0.25
      }
    }
  ]
