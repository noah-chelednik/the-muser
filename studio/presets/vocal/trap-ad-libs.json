  "category": "vocal",
  "subcategory": "vocals",
  "tags": [
    "trap",
    "adlib",
    "fx"
  ],
  "description": "Telephone-style filtered ad-libs with delay.",
  "version": 1,
  "factory": true,
  "role": "vocals",
