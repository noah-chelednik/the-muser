{
  "id": "vocal/radio-pop-vocal",
  "name": "Radio Pop Vocal",
  "category": "vocal",
  "subcategory": "vocals",
  "tags": [
    "pop",
    "bright"
  ],
  "description": "Bright, compressed and upfront.",
  "version": 1,
  "factory": true,
  "role": "vocals",
  "chain": [
    {
      "type": "highpass",
      "params": {
        "cutoff_hz": 90
      }
    },
    {
