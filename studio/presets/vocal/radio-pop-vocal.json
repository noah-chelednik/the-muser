        "ratio": 4,
        "attack_ms": 5,
        "release_ms": 80,
        "makeup_db": 4
      }
    },
    {
      "type": "deesser",
      "params": {
        "frequency_hz": 7000,
        "threshold_db": -28,
        "ratio": 4
      }
    },
    {
      "type": "highshelf",
      "params": {
        "cutoff_hz": 10000,
        "gain_db": 3,
        "q": 0.7
      }
    },
    {
      "type": "reverb",
      "params": {
        "room_size": 0.45,
        "damping": 0.5,
        "width": 1.0,
        "mix": 0.12
      }
    }
  ]
}
